class CalendarApp(QMainWindow, AbstractAppView, metaclass=PyQtABCMeta):
    def __init__(self):
        super().__init__()
        self.login = "UserName"
        self.time_in = datetime.now()

        self.events = self.load_events()
        self.events.sort()
        self.selected_index = None

        self.build_ui()

    def build_ui(self):
        self.setWindowTitle("Календарь (PyQt6 + ООП)")
        self.resize(850, 550)

        central_widget = QWidget()
        self.setCentralWidget(central_widget)

        main_layout = MyHBoxLayout(central_widget)

        left_group = MyGroupBox("Список событий")
        left_layout = MyVBoxLayout()

        self.list_widget = MyListWidget()
        self.list_widget.currentRowChanged.connect(self.select_event)
        self.update_list_ui()

        left_layout.addWidget(self.list_widget)
        left_group.setLayout(left_layout)

        right_group = MyGroupBox("Детали события")
        right_layout = MyVBoxLayout()

        right_layout.addWidget(MyLabel("Название:"))
        self.title_input = MyLineEdit()
        right_layout.addWidget(self.title_input)

        right_layout.addWidget(MyLabel("Дата (ДД.ММ.ГГГГ):"))
        self.date_input = MyLineEdit()
        right_layout.addWidget(self.date_input)

        right_layout.addWidget(MyLabel("Описание:"))
        self.desc_input = MyTextEdit()
        right_layout.addWidget(self.desc_input)

        self.save_btn = MyPushButton("Сохранить изменения")
        self.save_btn.clicked.connect(self.save_event)
        right_layout.addWidget(self.save_btn)

        right_group.setLayout(right_layout)

        splitter = QSplitter(Qt.Orientation.Horizontal)
        splitter.addWidget(left_group)
        splitter.addWidget(right_group)
        splitter.setSizes([350, 500])

        main_layout.addWidget(splitter)

        self.status_bar = MyStatusBar()
        self.setStatusBar(self.status_bar)
        self.status_bar.showMessage("Готово")

    def update_list_ui(self):
        self.list_widget.clear()
        for event in self.events:
            item = QListWidgetItem(str(event))
            item.setToolTip(event.description)
            self.list_widget.addItem(item)

    def select_event(self, index):
        if index < 0 or index >= len(self.events):
            return
        self.selected_index = index
        event = self.events[index]

        self.title_input.setText(event.title)
        self.date_input.setText(event.date)
        self.desc_input.setText(event.description)

    def save_event(self):
        if self.selected_index is None:
            QMessageBox.warning(self, "Ошибка", "Выберите событие из списка!")
            return

        event = self.events[self.selected_index]
        event.title = self.title_input.text()
        event.date = self.date_input.text()
        event.description = self.desc_input.toPlainText()

        self.save_events_to_file()
        self.update_list_ui()

        self.list_widget.setCurrentRow(self.selected_index)
        self.status_bar.showMessage("Событие успешно обновлено!", 3000)

    def save_events_to_file(self):
        filename = "events_data.txt"
        try:
            with open(filename, "w", encoding="utf-8") as f:
                for event in self.events:
                    f.write(f"{event.event_id}|||{event.title}|||{event.date}|||{event.description}\n")
        except Exception as e:
            print(f"Ошибка сохранения: {e}")

    def load_events(self):
        filename = "events_data.txt"
        if not os.path.exists(filename):
            return [
                CalendarEvent(1, "Анапа", "29.10.2026", "поехать в анапу за справкой для суда"),
                CalendarEvent(2, "Зачет", "19.10.2026", "ООП"),
                CalendarEvent(3, "Барбер", "20.10.2026", "15:40"),
                CalendarEvent(4, "Тренировка", "21.10.2026", "Спортзал"),
                CalendarEvent(5, "День рождения", "05.02.2027", "Купить торт"),
                CalendarEvent(6, "Машина", "20.11.2026", "забрать машину с сто"),
                CalendarEvent(7, "Оплата связи", "09.11.2026", "МТС"),
                CalendarEvent(8, "Павел", "25.11.2026", "туса в Новоросе"),
                CalendarEvent(9, "День рождения", "05.12.2026", "папа"),
                CalendarEvent(10, "Новый год", "31.12.2026", "Подготовка")
            ]

        evs = []
        try:
            with open(filename, "r", encoding="utf-8") as f:
                for line in f:
                    p = line.strip().split("|||")
                    if len(p) == 4:
                        evs.append(CalendarEvent(int(p[0]), p[1], p[2], p[3]))
        except Exception:
            pass
        return evs if evs else [CalendarEvent(1, "Ошибка загрузки", "01.01.2026", "")]

    @staticmethod
    def generate_report(login, time_in, time_out):
        filename = "report.txt"
        fmt = "%d.%m.%Y %H:%M:%S"
        with open(filename, "w", encoding="utf-8") as f:
            f.write("| login | time_in | time_out |\n")
            f.write("|---|---|---|\n")
            f.write(f"| {login} | {time_in.strftime(fmt)} | {time_out.strftime(fmt)} |\n")
        print(f"Отчет сохранен в {filename}")

    def closeEvent(self, event):
        self.save_events_to_file()
        time_out = datetime.now()
        CalendarApp.generate_report(self.login, self.time_in, time_out)
        super().closeEvent(event)

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = CalendarApp()
    window.show()
    sys.exit(app.exec())
