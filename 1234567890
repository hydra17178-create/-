class CustomPair:
    def __init__(self, key, value):
        self.key = key
        self.value = value


class CustomMap:
    def __init__(self):
        self._data = []

    def put(self, key, value):
        self._data.append(CustomPair(key, value))

    def get(self, key):
        for pair in self._data:
            if pair.key == key:
                return pair.value
        return None



class AbstractEntity(ABC):
    @abstractmethod
    def get_info(self):
        pass


class AbstractAppView(ABC):
    @abstractmethod
    def build_ui(self):
        pass



class PyQtABCMeta(ABCMeta, type(QMainWindow)):
    pass


class CalendarEvent(AbstractEntity):
    def __init__(self, event_id, title, date_str, description):
        self._id = event_id
        self._title = title
        self._date = date_str
        self._description = description

    @property
    def title(self):
        return self._title

    @title.setter
    def title(self, value):
        self._title = value

    @property
    def date(self):
        return self._date

    @date.setter
    def date(self, value):
        self._date = value

    @property
    def description(self):
        return self._description

    @description.setter
    def description(self, value):
        self._description = value

    @property
    def event_id(self):
        return self._id

    def get_info(self):
        return f"{self._date}: {self._title}"

    def __eq__(self, other):
        if isinstance(other, CalendarEvent):
            return self._id == other._id
        return False

    def __lt__(self, other):
        if isinstance(other, CalendarEvent):
            d1 = datetime.strptime(self._date, "%d.%m.%Y")
            d2 = datetime.strptime(other._date, "%d.%m.%Y")
            return d1 < d2
        return False

    def __repr__(self):
        return f"CalendarEvent(id={self._id}, title='{self._title}')"

    def __str__(self):
        return f"{self._date} - {self._title}"

    def __hash__(self):
        return hash(self._id)

    def __len__(self):
        return len(self._title)



